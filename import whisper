# 2. معالجة اللغة الطبيعية (NLP)
def process_query(text):
    # إرسال النص إلى نموذج LLM مع سياق الذاكرة
    response = requests.post("http://localhost:8000/generate", json={
        "query": text,
        "memory_context": get_user_memory()
    })
    return response.json()["reply"]

# 3. توليد الصوت
def speak(text):
    # استخدام TTS بصوت أنثوي رقيق
    tts_url = generate_tts_voice(text, voice="layl_fine_female")
    play_audio(tts_url)

# حلقة العمل الرئيسية
while True:
    user_input = listen_for_wake_word()
    ai_response = process_query(user_input)
    speak(ai_response)
